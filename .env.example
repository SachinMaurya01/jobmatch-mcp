# Copy to .env and fill in. Never commit .env.

# Application
JOBMATCH_APP_ENV=local
JOBMATCH_LOG_LEVEL=INFO

# PostgreSQL (pgvector). Docker Compose uses these defaults.
JOBMATCH_DATABASE_URL=postgresql+psycopg://jobmatch:jobmatch@localhost:5432/jobmatch

# JSearch via RapidAPI (https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch)
JOBMATCH_JSEARCH_API_KEY=
JOBMATCH_JSEARCH_COUNTRY=in

# Greenhouse public job boards (comma-separated board tokens)
JOBMATCH_GREENHOUSE_BOARDS=

# Lever public postings (comma-separated company tokens)
JOBMATCH_LEVER_COMPANIES=

# SerpAPI Google Jobs (https://serpapi.com/)
JOBMATCH_SERPAPI_API_KEY=
JOBMATCH_SERPAPI_COUNTRY=in

# Search
JOBMATCH_SEARCH_DEFAULT_LIMIT=30
JOBMATCH_SEARCH_MAX_LIMIT=30
JOBMATCH_MIN_MATCH_SCORE=60
JOBMATCH_HTTP_TIMEOUT_SECONDS=10
JOBMATCH_SOURCE_TIMEOUT_SECONDS=20

# Per-source cache and rate limits
JOBMATCH_CONNECTOR_CACHE_TTL_SECONDS=300
JOBMATCH_CONNECTOR_CACHE_MAX_ENTRIES=256
JOBMATCH_JSEARCH_RATE_LIMIT_PER_MINUTE=30
JOBMATCH_GREENHOUSE_RATE_LIMIT_PER_MINUTE=60
JOBMATCH_LEVER_RATE_LIMIT_PER_MINUTE=60
JOBMATCH_SERPAPI_RATE_LIMIT_PER_MINUTE=30

# Privacy: never send resume data to hosted LLM providers.
JOBMATCH_DISABLE_HOSTED_FALLBACK=true
