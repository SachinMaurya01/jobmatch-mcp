# Copy to .env and fill in. Never commit .env.

# Application
JOBMATCH_APP_ENV=local
JOBMATCH_LOG_LEVEL=INFO

# PostgreSQL (pgvector). Docker Compose uses these defaults.
JOBMATCH_DATABASE_URL=postgresql+psycopg://jobmatch:jobmatch@localhost:5432/jobmatch

# pgAdmin local UI (http://127.0.0.1:5050)
PGADMIN_DEFAULT_EMAIL=admin@jobmatch.dev
PGADMIN_DEFAULT_PASSWORD=jobmatch

# JSearch via RapidAPI (https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch)
JOBMATCH_JSEARCH_API_KEY=
JOBMATCH_JSEARCH_COUNTRY=in

# Greenhouse public job boards (comma-separated board tokens)
JOBMATCH_GREENHOUSE_BOARDS=adobe,affirm,airbnb,amazon,amd,americanexpress,anduril,anthropic,apple,applovin,asana,atlassian,blackrock,block,bloomberg,box,brex,browserstack,canva,capgemini,chargebee,checkout, circle,cisco,citadel,citadel-securities,cloudflare,cognizant,coinbase,confluent,cred,crowdstrike,deshaw,databricks,datadog,dell,discord,doordash,dropbox,drw,dunzo,duolingo,ebay,elastic,epam,epicgames,etsy,figma,fiverings,flipkart,goldmansachs,google,googledeepmind,groww,hp,hsbc,hubspot,hudsonrivertrading,ibm,imc,infosys,instacart,intel,intuit,jpmorganchase,janestreet,jumptrading,juspay,linkedin,lyft,meesho,meta,microsoft,morganstanley,netflix,nike,notion,nutanix,nvidia,okta,openai,optiver,oracle,palantir,paypal,paytm,phonepe,pinterest,plaid,postman,publicissapient,purestorage,qualcomm,ramp,razorpay,reddit,renaissancetechnologies,riotgames,rippling,robinhood,roblox,rubrik,salesforce,sap,servicenow,shopify,snap,snowflake,sofi,spotify,stripe,swiggy,target,tcs,tesla,thetradedesk,thoughtworks,tiktok,turnitin,twilio,twosigma,uber,uipath,upstart,vercel,verkada,vmware,walmartglobaltech,waymo,workday,x-xai,zepto,zomato,zoom

# Lever public postings (comma-separated company tokens)
JOBMATCH_LEVER_COMPANIES=adobe,affirm,airbnb,amazon,amd,americanexpress,anduril,anthropic,apple,applovin,asana,atlassian,blackrock,block,bloomberg,box,brex,browserstack,canva,capgemini,chargebee,checkout, circle,cisco,citadel,citadel-securities,cloudflare,cognizant,coinbase,confluent,cred,crowdstrike,deshaw,databricks,datadog,dell,discord,doordash,dropbox,drw,dunzo,duolingo,ebay,elastic,epam,epicgames,etsy,figma,fiverings,flipkart,goldmansachs,google,googledeepmind,groww,hp,hsbc,hubspot,hudsonrivertrading,ibm,imc,infosys,instacart,intel,intuit,jpmorganchase,janestreet,jumptrading,juspay,linkedin,lyft,meesho,meta,microsoft,morganstanley,netflix,nike,notion,nutanix,nvidia,okta,openai,optiver,oracle,palantir,paypal,paytm,phonepe,pinterest,plaid,postman,publicissapient,purestorage,qualcomm,ramp,razorpay,reddit,renaissancetechnologies,riotgames,rippling,robinhood,roblox,rubrik,salesforce,sap,servicenow,shopify,snap,snowflake,sofi,spotify,stripe,swiggy,target,tcs,tesla,thetradedesk,thoughtworks,tiktok,turnitin,twilio,twosigma,uber,uipath,upstart,vercel,verkada,vmware,walmartglobaltech,waymo,workday,x-xai,zepto,zomato,zoom

# SerpAPI Google Jobs (https://serpapi.com/)
JOBMATCH_SERPAPI_API_KEY=
JOBMATCH_SERPAPI_COUNTRY=in

# Search
JOBMATCH_SEARCH_DEFAULT_LIMIT=30
JOBMATCH_SEARCH_MAX_LIMIT=30
JOBMATCH_MIN_MATCH_SCORE=60
JOBMATCH_HTTP_TIMEOUT_SECONDS=10
JOBMATCH_SOURCE_TIMEOUT_SECONDS=20
JOBMATCH_ENABLE_ELICITATION=true

# MCP transport (stdio for Claude Desktop, http for MCP Inspector/hosted)
JOBMATCH_TRANSPORT=stdio
JOBMATCH_HTTP_HOST=127.0.0.1
JOBMATCH_HTTP_PORT=8000
JOBMATCH_HTTP_PATH=/mcp
JOBMATCH_HTTP_BEARER_TOKEN=
JOBMATCH_HTTP_JSON_RESPONSE=false
JOBMATCH_HTTP_STATELESS=false

# Per-source cache and rate limits
JOBMATCH_CONNECTOR_CACHE_TTL_SECONDS=300
JOBMATCH_CONNECTOR_CACHE_MAX_ENTRIES=256
JOBMATCH_JSEARCH_RATE_LIMIT_PER_MINUTE=30
JOBMATCH_GREENHOUSE_RATE_LIMIT_PER_MINUTE=60
JOBMATCH_LEVER_RATE_LIMIT_PER_MINUTE=60
JOBMATCH_SERPAPI_RATE_LIMIT_PER_MINUTE=30

# Hybrid ranking: local embeddings (fixed model per index)
JOBMATCH_ENABLE_SEMANTIC=true
JOBMATCH_EMBEDDING_MODEL=nomic-embed-text
JOBMATCH_EMBEDDING_BASE_URL=http://localhost:11434
JOBMATCH_EMBEDDING_TIMEOUT_SECONDS=30
JOBMATCH_EMBEDDING_MAX_JOBS=100

# LLM re-rank router: Ollama -> OpenAI -> Claude
JOBMATCH_ENABLE_LLM_RERANK=true
JOBMATCH_RERANK_TOP_N=20
JOBMATCH_RERANK_MAX_ADJUSTMENT=10
JOBMATCH_LLM_MAX_CONSECUTIVE_FAILURES=3
JOBMATCH_LLM_CIRCUIT_COOLDOWN_SECONDS=60
JOBMATCH_LLM_MAX_OUTPUT_TOKENS=1500
JOBMATCH_LLM_RECENT_CALLS_LIMIT=20

# Primary local provider
JOBMATCH_OLLAMA_BASE_URL=http://localhost:11434
JOBMATCH_OLLAMA_MODEL=qwen2.5:7b
JOBMATCH_OLLAMA_TIMEOUT_SECONDS=30
JOBMATCH_OLLAMA_COST_PER_MILLION_TOKENS=0

# Hosted fallbacks (only used when hosted fallback is enabled)
JOBMATCH_OPENAI_API_KEY=
JOBMATCH_OPENAI_MODEL=gpt-4o-mini
JOBMATCH_OPENAI_TIMEOUT_SECONDS=30
JOBMATCH_OPENAI_INPUT_COST_PER_MILLION=0.15
JOBMATCH_OPENAI_OUTPUT_COST_PER_MILLION=0.60

JOBMATCH_ANTHROPIC_API_KEY=
JOBMATCH_ANTHROPIC_MODEL=claude-3-5-haiku-latest
JOBMATCH_ANTHROPIC_TIMEOUT_SECONDS=30
JOBMATCH_ANTHROPIC_INPUT_COST_PER_MILLION=0.80
JOBMATCH_ANTHROPIC_OUTPUT_COST_PER_MILLION=4.00

# Privacy: never send resume data to hosted LLM providers.
JOBMATCH_DISABLE_HOSTED_FALLBACK=true
